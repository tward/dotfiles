#!/usr/bin/env bash
#
# ddc-brightness — step external-monitor brightness up/down over DDC/CI
# (ddcutil), with an instant OSD popup via notify-send/swaync. Bound to the
# XF86MonBrightness* keys in niri/config.kdl.
#
# Why this exists: the only display is an external monitor, which has no
# /sys/class/backlight device, so brightnessctl can't touch it. Brightness
# goes over the DDC/CI i2c bus (VCP feature 0x10) instead, which needs the
# i2c-dev module + udev access rule (both set up by install-linux.sh) and
# ddcutil.
#
# Speed: ddcutil's display detection re-scans every i2c bus and costs ~0.45 s
# per call — ~90% of keypress latency (measured: getvcp 489 ms with detection,
# 41 ms with --bus; setvcp 76 ms). So the monitor's bus number is discovered
# once (slow first press) and cached. The cache lives in XDG_RUNTIME_DIR
# because bus numbers can change across boots/replugs; a replug within a
# session is handled by re-detecting once when the cached bus stops answering.
#
# The brightness *level* is deliberately not cached: the monitor's own
# auto-brightness sensor rewrites VCP 0x10 whenever ambient light changes, so
# any cached level drifts within seconds. With --bus, a fresh read per press
# is cheap, every step starts from the true current value, and the keys
# coexist with auto-brightness instead of fighting it.

set -euo pipefail

STEP=10
VCP_BRIGHTNESS=10   # VCP feature code 0x10 = luminance
STATE_DIR="${XDG_RUNTIME_DIR:-/tmp}/ddc-brightness"
mkdir -p "$STATE_DIR"

die() {
    notify-send -e -t 3000 -u critical "Brightness" "$1" 2>/dev/null || true
    exit 1
}

detect_bus() {
    ddcutil detect --brief | sed -n 's|.*I2C bus:[[:space:]]*/dev/i2c-||p' | head -n1
}

read_level() {
    # --brief getvcp prints "VCP 10 C <current> <max>".
    ddcutil --bus "$bus" --brief getvcp "$VCP_BRIGHTNESS" | awk '{print $4}'
}

# Serialize concurrent invocations (key auto-repeat): later presses queue on
# earlier ones instead of racing each other onto the i2c bus.
exec 9>"$STATE_DIR/lock"
flock 9

bus=""
[ -s "$STATE_DIR/bus" ] && bus=$(<"$STATE_DIR/bus")
if [ -z "$bus" ]; then
    bus=$(detect_bus)
    [ -n "$bus" ] || die "ddcutil found no DDC display — i2c-dev loaded? udev rule applied?"
    echo "$bus" > "$STATE_DIR/bus"
fi

if ! cur=$(read_level) || [ -z "$cur" ]; then
    # Cached bus stopped answering — monitor likely replugged onto a new bus
    # number. Re-detect once and retry before giving up.
    bus=$(detect_bus)
    [ -n "$bus" ] || die "ddcutil found no DDC display — monitor disconnected?"
    echo "$bus" > "$STATE_DIR/bus"
    cur=$(read_level) || die "ddcutil getvcp failed on bus $bus"
    [ -n "$cur" ] || die "could not parse current brightness from ddcutil"
fi

case "${1:-}" in
    up)   new=$(( cur + STEP )) ;;
    down) new=$(( cur - STEP )) ;;
    *)    echo "usage: ddc-brightness up|down" >&2; exit 2 ;;
esac
(( new > 100 )) && new=100
(( new < 0 ))  && new=0

# OSD before the write — feedback lands ~75 ms sooner. -e (transient) keeps it
# out of the swaync history; -p/-r replace the previous popup instead of
# stacking; the int:value hint renders swaync's progress bar.
nid=""
[ -s "$STATE_DIR/notify-id" ] && nid=$(<"$STATE_DIR/notify-id")
notify-send -p -e -t 1500 ${nid:+-r "$nid"} \
    -h int:value:"$new" "Brightness ${new}%" > "$STATE_DIR/notify-id" || true

ddcutil --bus "$bus" --noverify setvcp "$VCP_BRIGHTNESS" "$new" ||
    die "ddcutil setvcp failed on bus $bus"
