#!/usr/bin/env bash
#
# niri-display-mode — switch the external monitor between display profiles over
# niri IPC, and expose them through three front-ends: a Mod+G game/desktop
# toggle, a Mod+Shift+G fuzzel menu, and a waybar module (left-click toggle,
# right-click menu). Built to ~/.local/bin by install-linux.conf.yaml.
#
# Why this exists: niri/Wayland won't let a fullscreen game negotiate its own
# resolution (no client-facing output-mode protocol), so a game is stuck
# rendering at whatever mode the compositor is in. At our desktop default
# (3840x2160 @ scale 1.5) the GPU rasterises the full 4K — 8.3M px — REGARDLESS
# of scale: scale only changes logical coordinates, not what the GPU draws.
# Switching the output to a true 2560x1440 mode at scale 1.0 cuts that to 3.7M
# px (~44%) for a large, free performance win in games.
#
# The desktop and 1440p profiles share the SAME logical size (3840/1.5 =
# 2560/1.0 = 2560x1440), so the toggle does NOT reflow the desktop — only the
# physical render resolution changes. (The 1080p menu profile is scale 1.0 too,
# so it DOES reflow to 1920x1080 logical; fine for a fullscreen game.) Game
# profiles turn VRR on (left off on the desktop, where some panels flicker on
# static content); see the README VRR notes.
#
# niri's `output` IPC changes are temporary and forgotten on a config reload —
# which is exactly what we want here: profiles auto-revert to the configured
# desktop default on the next `niri msg action load-config-file`, reboot, etc.

set -euo pipefail

# Match the monitor by EDID model, not connector: everything then keeps working
# if the panel lands on a different DP/HDMI port (the connector name "DP-4" is
# not stable across replugs; the model is). Change MODEL for a different panel.
MODEL="DELL U2725QE"

DESKTOP_MODE="3840x2160@120.000"; DESKTOP_SCALE="1.5"
GAME_MODE="2560x1440@119.998";    GAME_SCALE="1.0"

# Profiles offered by the fuzzel menu: "label|mode|scale|vrr". niri validates
# each mode against the panel's EDID, so edit freely. 1080p is an exact integer
# 2x of 4K (cleaner upscale, lighter GPU) than 1440p's soft 1.5x; 4K-60 is for
# a quieter/cooler desktop.
MENU=(
    "Desktop — 4K · 120 Hz (native, sharp)|$DESKTOP_MODE|$DESKTOP_SCALE|off"
    "Game — 1440p · 120 Hz · VRR|$GAME_MODE|$GAME_SCALE|on"
    "Game — 1080p · 120 Hz · VRR (crisp 2x)|1920x1080@120.000|1.0|on"
    "4K · 60 Hz (quiet)|3840x2160@60.000|1.5|off"
)

# waybar custom module is refreshed by this RT signal (see waybar/config.jsonc
# "signal"); keep the two in sync.
WAYBAR_SIGNAL=8

STATE_DIR="${XDG_RUNTIME_DIR:-/tmp}/niri-display-mode"

# Current monitor state, filled by detect(): connector name, physical mode
# width/height, refresh (mHz), logical scale, and whether VRR is enabled.
OUTPUT="" CUR_W="" CUR_H="" CUR_R="" CUR_SCALE="" CUR_VRR=""
detect() {
    read -r OUTPUT CUR_W CUR_H CUR_R CUR_SCALE CUR_VRR < <(
        niri msg --json outputs | jq -r --arg m "$MODEL" '
            to_entries[] | select(.value.model == $m) | .value as $o
            | $o.modes[$o.current_mode] as $cm
            | "\(.key) \($cm.width) \($cm.height) \($cm.refresh_rate) \($o.logical.scale) \($o.vrr_enabled)"'
    ) || true
}

# Transient OSD via swaync. -e keeps it out of the notification history; -p
# prints the id which we stash and feed back with -r so repeated toggles
# replace the popup instead of stacking it (same pattern as ddc-brightness).
osd() {
    mkdir -p "$STATE_DIR"
    local nid=""
    [ -s "$STATE_DIR/notify-id" ] && nid=$(<"$STATE_DIR/notify-id")
    notify-send -p -e -t 2000 ${nid:+-r "$nid"} "$1" > "$STATE_DIR/notify-id" 2>/dev/null || true
}

die() {
    notify-send -e -t 3000 -u critical "Display mode" "$1" 2>/dev/null || true
    echo "niri-display-mode: $1" >&2
    exit 1
}

# Nudge the waybar module to re-read state immediately after a change, instead
# of waiting for its slow safety-poll interval. No-op if waybar isn't running.
refresh_waybar() { pkill "-RTMIN+${WAYBAR_SIGNAL}" waybar 2>/dev/null || true; }

# Apply a full profile. Three IPC calls (niri applies one output action at a
# time); a brief intermediate state during the swap is harmless for a
# deliberate switch. $1=mode $2=scale $3=on|off (vrr) $4=OSD label.
apply() {
    niri msg output "$OUTPUT" mode "$1"
    niri msg output "$OUTPUT" scale "$2"
    niri msg output "$OUTPUT" vrr "$3"
    osd "$4"
    refresh_waybar
}

apply_game()    { apply "$GAME_MODE"    "$GAME_SCALE"    on  "Game mode · 1440p · 120 Hz · VRR on"; }
apply_desktop() { apply "$DESKTOP_MODE" "$DESKTOP_SCALE" off "Desktop mode · 4K · 120 Hz"; }

# fuzzel picker over MENU plus a VRR toggle that reflects the live state. The
# chosen label is matched back to its profile (kept simple: labels are unique).
menu() {
    local labels=() entry choice rest mode scale vrr
    for entry in "${MENU[@]}"; do labels+=("${entry%%|*}"); done
    local vstate="off"; [ "$CUR_VRR" = "true" ] && vstate="on"
    local vrr_label="Toggle VRR  (now: ${vstate})"

    choice=$(printf '%s\n' "${labels[@]}" "$vrr_label" |
        fuzzel --dmenu --prompt "Display  ") || exit 0
    [ -n "$choice" ] || exit 0

    if [ "$choice" = "$vrr_label" ]; then
        if [ "$CUR_VRR" = "true" ]; then niri msg output "$OUTPUT" vrr off; osd "VRR off"
        else niri msg output "$OUTPUT" vrr on; osd "VRR on"; fi
        refresh_waybar; return
    fi

    for entry in "${MENU[@]}"; do
        [ "${entry%%|*}" = "$choice" ] || continue
        rest=${entry#*|}                 # mode|scale|vrr
        mode=${rest%%|*}; rest=${rest#*|}
        scale=${rest%%|*}; vrr=${rest##*|}
        apply "$mode" "$scale" "$vrr" "$choice"
        return
    done
}

# JSON line for waybar's custom module: short text, descriptive tooltip, and a
# class ("desktop"/"game") so style.css can accent game mode.
print_waybar() {
    if [ -z "$OUTPUT" ]; then
        printf '{"text":"","tooltip":"display: %s not found","class":"none"}\n' "$MODEL"
        return
    fi
    local label class hz vrr
    case "$CUR_W" in
        3840) label="4K";    class="desktop" ;;
        2560) label="1440p"; class="game" ;;
        1920) label="1080p"; class="game" ;;
        *)    label="${CUR_W}px"; class="other" ;;
    esac
    hz=$(( (CUR_R + 500) / 1000 ))       # mHz -> Hz, rounded (119998 -> 120)
    vrr="off"; [ "$CUR_VRR" = "true" ] && vrr="on"
    printf '{"text":"%s","tooltip":"%sx%s @ %s Hz · scale %s · VRR %s","class":"%s"}\n' \
        "$label" "$CUR_W" "$CUR_H" "$hz" "$CUR_SCALE" "$vrr" "$class"
}

detect

# Read-only front-ends first: they tolerate a missing monitor gracefully.
case "${1:-toggle}" in
    waybar) print_waybar; exit 0 ;;
    status)
        if [ "$CUR_W" = "3840" ]; then echo desktop
        elif [ -n "$CUR_W" ]; then echo game
        else echo unknown; fi
        exit 0 ;;
esac

[ -n "$OUTPUT" ] || die "monitor \"$MODEL\" not found in niri outputs"

case "${1:-toggle}" in
    game)    apply_game ;;
    desktop) apply_desktop ;;
    # Any non-4K mode counts as "in a game profile" → go back to desktop.
    toggle)  if [ "$CUR_W" = "3840" ]; then apply_game; else apply_desktop; fi ;;
    menu)    menu ;;
    *) echo "usage: niri-display-mode [toggle|game|desktop|menu|waybar|status]" >&2; exit 2 ;;
esac
