#!/usr/bin/env bash
#
# wifi-menu — fuzzel picker for joining Wi-Fi networks from the niri session,
# over nmcli. Opened by clicking the waybar network module (waybar/config.jsonc).
#
#   wifi-menu           scan (with a "Scanning…" popup), then open the picker
#   wifi-menu rescan    same, but force a new scan even if one just finished
#   wifi-menu list      print the menu lines from the cached scan and exit
#                       (no UI, no scan; for checking by hand)
#
# The picker always opens on a current scan, because a cached list shows signal
# numbers that can be minutes old. A scan blocks for several seconds (about
# 10 s on the lt3340), so a popup stays up for its duration: the wait is fine,
# a wait with nothing on screen is not. nmcli skips the scan when its last one
# is under 30 s old, so reopening right away is instant; the "Rescan" row
# forces a new one.
#
# Why this exists: the session has no network applet. nm-applet works but its
# tray icon is full-color with no symbolic variant, so waybar can't tint it to
# match the bar. This keeps the bar's own network glyph and reuses fuzzel, like
# niri-display-mode's menu.
#
# What it does: lists visible networks strongest first (one row per name),
# joins the chosen one, and offers "Disconnect" and "Turn Wi-Fi off/on". A
# network that already has a saved profile is brought up from that profile; an
# open network is joined directly; a WPA network prompts for its password in a
# second fuzzel box.
#
# Saved networks are NetworkManager system profiles in
# /etc/NetworkManager/system-connections/ (root-only files, password stored by
# NetworkManager, auto-connect on). No keyring is involved.
#
# A new network's password never appears on a command line. The obvious
# `nmcli device wifi connect SSID password PW` puts it in the process list,
# readable by every local process while nmcli runs. Instead the profile is
# created without a secret, then activated with the password piped to
# `passwd-file /dev/stdin`. The price is that this script, not nmcli, picks the
# key management type from the scan's SECURITY column.
#
# Limits, on purpose:
#   - Enterprise (802.1X), WEP, and hidden networks are not handled; use nmcli.
#   - Forgetting a network is `nmcli connection delete "<name>"` in a terminal.
#
# Needs no privileges: NetworkManager's polkit rules allow an active local
# session to control networking. Over SSH the same nmcli calls are refused.

set -uo pipefail

WAIT=30   # seconds nmcli may spend activating before giving up

info() { notify-send -e -t 4000 "Wi-Fi" "$1" 2>/dev/null || true; }
fail() { notify-send -e -t 8000 -u critical "Wi-Fi" "$1" 2>/dev/null || true; }

# nmcli's terse (-t / -g) output escapes ':' and '\' inside values.
unescape() {
    local s=$1
    s=${s//\\:/:}
    s=${s//\\\\/\\}
    printf '%s' "$s"
}

# Last line of nmcli's output, without its "Error: " prefix.
reason() {
    local line
    line=$(printf '%s\n' "$1" | tail -n1)
    printf '%s' "${line#Error: }"
}

dev=$(nmcli -t -f DEVICE,TYPE device 2>/dev/null | awk -F: '$2 == "wifi" { print $1; exit }')
if [ -z "$dev" ]; then
    info "No Wi-Fi device on this machine"
    exit 0
fi

radio=$(nmcli radio wifi 2>/dev/null)

# Saved Wi-Fi profiles, keyed by the SSID they are for (the profile name is
# usually the SSID, but need not be).
declare -A saved
while IFS=: read -r name type; do
    [ "$type" = "802-11-wireless" ] || continue
    name=$(unescape "$name")
    ssid=$(nmcli -g 802-11-wireless.ssid connection show id "$name" 2>/dev/null) || continue
    ssid=$(unescape "$ssid")
    [ -n "$ssid" ] && saved[$ssid]=$name
done < <(nmcli -t -f NAME,TYPE connection show 2>/dev/null)

# Visible networks. nmcli lists them strongest first, one row per access point,
# so the first row seen for a name is its best signal. Rows with an empty name
# are hidden networks. $1 is nmcli's --rescan mode: "no" reads the cache and
# returns at once, "yes" scans and blocks until the scan is finished, "auto"
# scans only when the last scan is more than 30 s old.
ssids=() secs=() menu=()
current=""
load_networks() {
    ssids=() secs=() menu=()
    current=""
    local -A seen=()
    local inuse signal sec ssid label
    while IFS=: read -r inuse signal sec ssid; do
        ssid=$(unescape "$ssid")
        [ -n "$ssid" ] || continue
        [ -z "${seen[$ssid]:-}" ] || continue
        seen[$ssid]=1
        [ "$sec" = "--" ] && sec=""

        label=$(printf '%3s%%  %s' "$signal" "$ssid")
        label+="  ·  ${sec:-open}"
        [ -n "${saved[$ssid]:-}" ] && label+="  ·  saved"
        if [ "$inuse" = "*" ]; then
            current=$ssid
            label+="  ·  connected"
        fi
        ssids+=("$ssid"); secs+=("$sec"); menu+=("$label")
    done < <(nmcli -t -f IN-USE,SIGNAL,SECURITY,SSID device wifi list ifname "$dev" --rescan "$1" 2>/dev/null)
}

# Scan with a popup that stays up for the duration, then is replaced by a
# short "done" so it clears as the menu appears. 20 s is only the popup's
# upper bound in case the replacement never lands. $1 is the --rescan mode.
scan_networks() {
    local nid
    nid=$(notify-send -p -e -t 20000 "Wi-Fi" "Scanning for networks…" 2>/dev/null) || nid=""
    load_networks "$1"
    notify-send -e -t 500 ${nid:+-r "$nid"} "Wi-Fi" "Scan complete" 2>/dev/null || true
}

if [ "$radio" = "enabled" ]; then
    case "${1:-}" in
        list)   load_networks no ;;
        rescan) scan_networks yes ;;
        *)      scan_networks auto ;;
    esac
fi

# Actions follow the networks; `actions` holds what each extra row does.
actions=()
if [ -n "$current" ]; then
    menu+=("Disconnect from $current"); actions+=(disconnect)
fi
if [ "$radio" = "enabled" ]; then
    menu+=("Rescan"); actions+=(rescan)
    menu+=("Turn Wi-Fi off"); actions+=(radio-off)
else
    menu+=("Turn Wi-Fi on"); actions+=(radio-on)
fi

if [ "${1:-}" = "list" ]; then
    printf '%s\n' "${menu[@]}"
    exit 0
fi

# --index returns the chosen row's position, so labels never have to be parsed
# back into network names. --width is in characters.
idx=$(printf '%s\n' "${menu[@]}" |
    fuzzel --dmenu --index --only-match --width 56 --prompt "Wi-Fi  ") || exit 0
[[ "$idx" =~ ^[0-9]+$ ]] || exit 0

n=${#ssids[@]}
if (( idx >= n )); then
    case "${actions[idx - n]:-}" in
        rescan) exec "$0" rescan ;;
        disconnect)
            if out=$(nmcli device disconnect "$dev" 2>&1); then info "Disconnected from $current"
            else fail "Could not disconnect: $(reason "$out")"; fi ;;
        radio-off) nmcli radio wifi off && info "Wi-Fi off" ;;
        radio-on)  nmcli radio wifi on && info "Wi-Fi on" ;;
    esac
    exit 0
fi

ssid=${ssids[idx]}
sec=${secs[idx]}
profile=${saved[$ssid]:-}

if [ "$ssid" = "$current" ]; then
    info "Already connected to $ssid"
    exit 0
fi

if [ -n "$profile" ]; then
    info "Connecting to $ssid…"
    if out=$(nmcli --wait "$WAIT" connection up id "$profile" ifname "$dev" 2>&1); then
        info "Connected to $ssid"
    else
        fail "Could not connect to $ssid: $(reason "$out"). If the password changed, forget it with: nmcli connection delete \"$profile\""
    fi
    exit 0
fi

if [[ "$sec" == *802.1X* ]]; then
    fail "$ssid is an enterprise (802.1X) network; this menu can't set it up. Use nmcli or nm-connection-editor."
    exit 0
fi

# Remove the profile this attempt created, so a failed join (wrong password,
# out of range) doesn't linger as a saved network. New profiles are named
# after the SSID, by nmcli in the open case and by this script otherwise.
forget_new() { nmcli connection delete id "$ssid" >/dev/null 2>&1 || true; }

# Open network: nothing secret, so nmcli creates and activates it in one step.
if [ -z "$sec" ]; then
    info "Connecting to $ssid…"
    if out=$(nmcli --wait "$WAIT" device wifi connect "$ssid" ifname "$dev" 2>&1); then
        info "Connected to $ssid"
    else
        forget_new
        fail "Could not connect to $ssid: $(reason "$out")"
    fi
    exit 0
fi

# Password network. A mixed WPA2/WPA3 network accepts wpa-psk; sae is only
# needed when WPA3 is all the access point offers.
case "$sec" in
    *WPA1*|*WPA2*) keymgmt=wpa-psk ;;
    *WPA3*)        keymgmt=sae ;;
    *)
        fail "$ssid uses $sec, which this menu can't set up. Use nmcli."
        exit 0 ;;
esac

# --prompt-only: no list, just the input line. --password masks the typing.
pw=$(fuzzel --dmenu --password --width 56 --prompt-only "Password for $ssid  ") || exit 0
[ -n "$pw" ] || exit 0

info "Connecting to $ssid…"

# Created with autoconnect off so NetworkManager doesn't start its own attempt
# (which would have no password) in the gap before the activation below.
if ! out=$(nmcli connection add type wifi con-name "$ssid" ssid "$ssid" \
        connection.autoconnect no wifi-sec.key-mgmt "$keymgmt" 2>&1); then
    fail "Could not set up $ssid: $(reason "$out")"
    exit 0
fi

# printf is a shell builtin, so the password goes down the pipe without ever
# being a process argument.
if out=$(printf '802-11-wireless-security.psk:%s\n' "$pw" |
        nmcli --wait "$WAIT" connection up id "$ssid" ifname "$dev" passwd-file /dev/stdin 2>&1); then
    nmcli connection modify id "$ssid" connection.autoconnect yes >/dev/null 2>&1 || true
    # NetworkManager should have stored the password it was handed. Confirm,
    # because without it the profile can't reconnect by itself.
    if [ -n "$(nmcli -s -g 802-11-wireless-security.psk connection show id "$ssid" 2>/dev/null)" ]; then
        info "Connected to $ssid"
    else
        fail "Connected to $ssid, but the password was not saved, so it won't reconnect by itself."
    fi
else
    forget_new
    fail "Could not connect to $ssid: $(reason "$out")"
fi
