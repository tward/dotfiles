# swaylock — screen locker. Nord theme.
# Invoked by Super+Alt+L (niri/config.kdl) and by swayidle on idle / before sleep.

ignore-empty-password
show-failed-attempts
indicator-radius=100
indicator-thickness=8

color=2e3440
inside-color=3b4252
ring-color=88c0d0
line-color=00000000
separator-color=00000000
text-color=eceff4

key-hl-color=a3be8c
bs-hl-color=ebcb8b

inside-clear-color=434c5e
ring-clear-color=88c0d0
inside-ver-color=434c5e
ring-ver-color=ebcb8b
inside-wrong-color=434c5e
ring-wrong-color=bf616a
text-wrong-color=bf616a
