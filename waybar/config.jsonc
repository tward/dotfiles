{
    // Built for niri. Icon glyphs are exact codepoints from
    // ~/dev/dotfiles/sketchybar, rendered with Hack Nerd Font Mono.
    "layer": "top",
    "position": "top",
    "height": 30,
    "spacing": 6,

    // Float the bar off the screen edges, matching sketchybar's margin/y_offset.
    "margin-top": 8,
    "margin-left": 12,
    "margin-right": 12,

    "modules-left": ["niri/workspaces", "niri/window"],
    "modules-center": ["custom/notification", "clock"],
    "modules-right": ["mpris", "cpu", "memory", "temperature", "pulseaudio", "network", "battery", "custom/display", "tray", "custom/power"],

    "niri/workspaces": { "format": "{value}" },
    "niri/window": { "format": "{title}", "max-length": 60 },

    "clock": {
        "format": "{:%a %d %b  %H:%M}",
        "tooltip-format": "<tt>{calendar}</tt>"
    },

    "mpris": {
        "format": "󰎈 {title} — {artist}",
        "format-paused": "󰏤 {title} — {artist}",
        "max-length": 50
    },

    "cpu": { "format": "<span size='xx-large'></span> <span rise='2500'>{usage}%</span>", "interval": 2 },

    "memory": {
        "format": "<span size='xx-large'>󱤓</span> <span rise='2500'>{percentage}%</span>",
        "interval": 5,
        "tooltip-format": "{used:0.1f}G / {total:0.1f}G used"
    },

    "temperature": {
        // No icon, but an invisible xx-large glyph gives temp the same tall
        // line-box as cpu/mem so the same rise centres it identically, instead
        // of fighting the shorter natural line-box with a large negative rise.
        "format": "<span size='xx-large' alpha='1%'>​</span><span rise='2500'>{temperatureC}°C</span>",
        "critical-threshold": 80
    },

    "pulseaudio": {
        "format": "{icon} <span rise='2100'>{volume}%</span>",
        "format-muted": "<span size='xx-large'>󰝟</span> <span rise='2500'>muted</span>",
        "format-icons": { "default": ["<span size='xx-large'>󰕿</span>", "<span size='xx-large'>󰖀</span>", "<span size='xx-large'>󰕾</span>"] },
        "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"
    },

    // Icon only. Wi-Fi shows one of four strength glyphs picked by signal
    // (nf-md-wifi_strength_1..4), wired shows nf-md-ethernet, no connection shows
    // nf-md-wifi_off. The network name and address live in the tooltip. Click
    // opens scripts/wifi-menu, a fuzzel picker over nmcli. Absolute $HOME path
    // because niri-spawned waybar lacks ~/.local/bin on PATH.
    "network": {
        "format-wifi": "{icon}",
        "format-icons": [
            "<span size='xx-large'>󰤟</span>", "<span size='xx-large'>󰤢</span>",
            "<span size='xx-large'>󰤥</span>", "<span size='xx-large'>󰤨</span>"
        ],
        "format-ethernet": "<span size='xx-large'>󰈀</span>",
        "format-linked": "<span size='xx-large'>󰤯</span>",
        "format-disabled": "<span size='xx-large'>󰤭</span>",
        "format-disconnected": "<span size='xx-large'>󰖪</span>",
        "tooltip-format-wifi": "{essid} · {signalStrength}% · {ipaddr}",
        "tooltip-format-ethernet": "{ifname} · {ipaddr}",
        "tooltip-format-disconnected": "offline",
        "tooltip-format": "{ifname}",
        "on-click": "$HOME/.local/bin/wifi-menu"
    },

    // Laptop battery. Listed unconditionally: on a machine with no battery in
    // /sys/class/power_supply waybar logs "No batteries." once and hides the
    // module, so the desktop bar is unchanged. Icons are nf-md-battery_10..90,
    // then full; charging swaps in nf-md-battery_charging.
    "battery": {
        "states": { "warning": 30, "critical": 15 },
        "format": "{icon} <span rise='2500'>{capacity}%</span>",
        "format-charging": "<span size='xx-large'>󰂄</span> <span rise='2500'>{capacity}%</span>",
        "format-icons": [
            "<span size='xx-large'>󰁺</span>", "<span size='xx-large'>󰁻</span>",
            "<span size='xx-large'>󰁼</span>", "<span size='xx-large'>󰁽</span>",
            "<span size='xx-large'>󰁾</span>", "<span size='xx-large'>󰁿</span>",
            "<span size='xx-large'>󰂀</span>", "<span size='xx-large'>󰂁</span>",
            "<span size='xx-large'>󰂂</span>", "<span size='xx-large'>󰁹</span>"
        ],
        "tooltip-format": "{capacity}% · {timeTo}"
    },

    "tray": { "spacing": 8 },

    // Notification bell: count/state from swaync, click toggles the center,
    // right-click toggles Do-Not-Disturb. swaync replaces mako (see install-linux.sh).
    "custom/notification": {
        "tooltip": false,
        "format": "{icon}",
        "format-icons": {
            "notification": "<span size='xx-large' foreground='#bf616a'>󰵙</span>",
            "none": "<span size='xx-large'>󰂜</span>",
            "dnd-notification": "<span size='xx-large' foreground='#bf616a'>󰂠</span>",
            "dnd-none": "<span size='xx-large'>󰂠</span>",
            "inhibited-notification": "<span size='xx-large' foreground='#bf616a'>󰵙</span>",
            "inhibited-none": "<span size='xx-large'>󰂜</span>",
            "dnd-inhibited-notification": "<span size='xx-large' foreground='#bf616a'>󰂠</span>",
            "dnd-inhibited-none": "<span size='xx-large'>󰂠</span>"
        },
        "return-type": "json",
        "exec-if": "which swaync-client",
        "exec": "swaync-client -swb",
        "on-click": "swaync-client -t -sw",
        "on-click-right": "swaync-client -d -sw",
        "escape": true
    },

    // Current display profile (4K / 1440p / 1080p). Left-click toggles game
    // mode, right-click opens the fuzzel display menu; both via niri-display-mode.
    // Absolute $HOME path because niri-spawned waybar lacks ~/.local/bin on PATH.
    // The script pings SIGRTMIN+8 after a change for an instant refresh; interval
    // is just a slow safety re-poll.
    "custom/display": {
        "format": "<span size='xx-large'>󰍹</span> <span rise='2500'>{}</span>",
        "return-type": "json",
        "exec": "$HOME/.local/bin/niri-display-mode waybar",
        "interval": 30,
        "signal": 8,
        "on-click": "$HOME/.local/bin/niri-display-mode toggle",
        "on-click-right": "$HOME/.local/bin/niri-display-mode menu"
    },

    "custom/power": {
        "format": "<span size='xx-large'>⏻</span>",
        "tooltip-format": "Power menu",
        "on-click": "sh $HOME/.config/waybar/powermenu.sh"
    }
}