{
    // Built for niri. Icon glyphs are exact codepoints from
    // ~/dev/dotfiles/sketchybar, rendered with Hack Nerd Font Propo (see
    // style.css for why that variant).
    //
    // Sizing convention: every icon is a Pango x-large span (1.44x the 13px base
    // font), and a label beside an icon carries rise='1500' to sit centred
    // against it. Both numbers were picked by eye from rendered mock-ups, not
    // derived; change them together if the icon size changes.
    "layer": "top",
    "position": "top",
    "height": 30,
    "spacing": 6,

    // Float the bar off the screen edges, matching sketchybar's margin/y_offset.
    "margin-top": 8,
    "margin-left": 12,
    "margin-right": 12,

    "modules-left": ["niri/workspaces", "niri/window"],
    "modules-center": ["custom/notification", "clock"],
    "modules-right": ["mpris", "cpu", "memory", "temperature", "pulseaudio", "battery", "custom/display", "network", "bluetooth", "tray", "custom/power"],

    "niri/workspaces": { "format": "{value}" },
    "niri/window": { "format": "{title}", "max-length": 60 },

    "clock": {
        "format": "{:%a %d %b  %H:%M}",
        "tooltip-format": "<tt>{calendar}</tt>"
    },

    "mpris": {
        "format": "󰎈 {title} — {artist}",
        "format-paused": "󰏤 {title} — {artist}",
        "max-length": 50
    },

    // Usage states are inclusive: 50–75% warning, 76% and above critical.
    "cpu": {
        "format": "<span size='x-large'></span> <span rise='1500'>{usage}%</span>",
        "interval": 2,
        "states": { "warning": 50, "critical": 76 }
    },

    "memory": {
        "format": "<span size='x-large'>󱤓</span> <span rise='1500'>{percentage}%</span>",
        "interval": 5,
        "states": { "warning": 50, "critical": 76 },
        "tooltip-format": "{used:0.1f}G / {total:0.1f}G used"
    },

    "temperature": {
        // CPU temperature from the CPU's own sensor, by permanent device path
        // (hwmonN numbers change between boots). With no sensor named, waybar
        // reads thermal_zone0, which on the lt3340 is "INT3400 Thermal", a
        // firmware placeholder fixed at 20°C. waybar uses the first path that
        // exists: Intel coretemp on the laptop (temp1 = package), AMD k10temp
        // on the desktop (temp1 = Tctl).
        "hwmon-path-abs": [
            "/sys/devices/platform/coretemp.0/hwmon",
            "/sys/devices/pci0000:00/0000:00:18.3/hwmon"
        ],
        "input-filename": "temp1_input",
        // No icon, but an invisible x-large glyph gives temp the same tall
        // line-box as cpu/mem so the same rise centres it identically, instead
        // of fighting the shorter natural line-box with a large negative rise.
        "format": "<span size='x-large' alpha='1%'>​</span><span rise='1500'>{temperatureC}°C</span>",
        "critical-threshold": 80
    },

    "pulseaudio": {
        "format": "{icon}",
        "format-muted": "<span size='x-large'>󰝟</span>",
        "tooltip-format": "{volume}% · {desc}",
        "format-icons": { "default": ["<span size='x-large'>󰕿</span>", "<span size='x-large'>󰖀</span>", "<span size='x-large'>󰕾</span>"] },
        "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"
    },

    // Icon only. Wi-Fi shows one of four strength glyphs picked by signal
    // (nf-md-wifi_strength_1..4), wired shows nf-md-ethernet, no connection shows
    // nf-md-wifi_off. The network name and address live in the tooltip. Click
    // opens scripts/wifi-menu, a fuzzel picker over nmcli. Absolute $HOME path
    // because niri-spawned waybar lacks ~/.local/bin on PATH.
    "network": {
        "format-wifi": "{icon}",
        "format-icons": [
            "<span size='x-large'>󰤟</span>", "<span size='x-large'>󰤢</span>",
            "<span size='x-large'>󰤥</span>", "<span size='x-large'>󰤨</span>"
        ],
        "format-ethernet": "<span size='x-large'>󰈀</span>",
        "format-linked": "<span size='x-large'>󰤯</span>",
        "format-disabled": "<span size='x-large'>󰤭</span>",
        "format-disconnected": "<span size='x-large'>󰖪</span>",
        "tooltip-format-wifi": "{essid} · {signalStrength}% · {ipaddr}",
        "tooltip-format-ethernet": "{ifname} · {ipaddr}",
        "tooltip-format-disconnected": "offline",
        "tooltip-format": "{ifname}",
        "on-click": "$HOME/.local/bin/wifi-menu"
    },

    // Laptop battery. Listed unconditionally: on a machine with no battery in
    // /sys/class/power_supply waybar logs "No batteries." once and hides the
    // module, so the desktop bar is unchanged. Icons are nf-md-battery_10..90,
    // then full; charging swaps in nf-md-battery_charging.
    "battery": {
        "states": { "warning": 30, "critical": 15 },
        "format": "{icon}",
        "format-charging": "<span size='x-large'>󰂄</span>",
        "format-icons": [
            "<span size='x-large'>󰁺</span>", "<span size='x-large'>󰁻</span>",
            "<span size='x-large'>󰁼</span>", "<span size='x-large'>󰁽</span>",
            "<span size='x-large'>󰁾</span>", "<span size='x-large'>󰁿</span>",
            "<span size='x-large'>󰂀</span>", "<span size='x-large'>󰂁</span>",
            "<span size='x-large'>󰂂</span>", "<span size='x-large'>󰁹</span>"
        ],
        "tooltip-format": "{capacity}% · {timeTo}"
    },

    // Bluetooth state as a glyph in the bar's own font and color, replacing
    // blueman-applet's full-color tray icon (hidden via a dconf default in
    // config-linux.sh; the applet itself keeps running for pairing prompts and
    // auto-connect). nf-md-bluetooth when on, nf-md-bluetooth_connect with a
    // device connected, nf-md-bluetooth_off when powered off or blocked. No
    // adapter gives empty text, which hides the module. Click opens the manager.
    "bluetooth": {
        "format": "<span size='x-large'>󰂯</span>",
        "format-connected": "<span size='x-large'>󰂱</span>",
        "format-off": "<span size='x-large'>󰂲</span>",
        "format-disabled": "<span size='x-large'>󰂲</span>",
        "format-no-controller": "",
        "tooltip-format": "Bluetooth {status}",
        "tooltip-format-connected": "{device_enumerate}",
        "tooltip-format-enumerate-connected": "{device_alias}",
        "tooltip-format-enumerate-connected-battery": "{device_alias} · {device_battery_percentage}%",
        "on-click": "blueman-manager"
    },

    "tray": { "spacing": 8 },

    // Notification bell: count/state from swaync, click toggles the center,
    // right-click toggles Do-Not-Disturb. swaync replaces mako (see install-linux.sh).
    "custom/notification": {
        "tooltip": false,
        "format": "{icon}",
        "format-icons": {
            "notification": "<span size='x-large' foreground='#bf616a'>󰵙</span>",
            "none": "<span size='x-large'>󰂜</span>",
            "dnd-notification": "<span size='x-large' foreground='#bf616a'>󰂠</span>",
            "dnd-none": "<span size='x-large'>󰂠</span>",
            "inhibited-notification": "<span size='x-large' foreground='#bf616a'>󰵙</span>",
            "inhibited-none": "<span size='x-large'>󰂜</span>",
            "dnd-inhibited-notification": "<span size='x-large' foreground='#bf616a'>󰂠</span>",
            "dnd-inhibited-none": "<span size='x-large'>󰂠</span>"
        },
        "return-type": "json",
        "exec-if": "which swaync-client",
        "exec": "swaync-client -swb",
        "on-click": "swaync-client -t -sw",
        "on-click-right": "swaync-client -d -sw",
        "escape": true
    },

    // Current display profile (4K / 1440p / 1080p). Left-click toggles game
    // mode, right-click opens the fuzzel display menu; both via niri-display-mode.
    // Absolute $HOME path because niri-spawned waybar lacks ~/.local/bin on PATH.
    // The script pings SIGRTMIN+8 after a change for an instant refresh; interval
    // is just a slow safety re-poll. hide-empty-text: on a machine without the
    // external monitor the script prints empty text, but the icon in "format"
    // would still show; this hides the whole module instead.
    "custom/display": {
        "hide-empty-text": true,
        "format": "<span size='x-large'>󰍹</span> <span rise='1500'>{}</span>",
        "return-type": "json",
        "exec": "$HOME/.local/bin/niri-display-mode waybar",
        "interval": 30,
        "signal": 8,
        "on-click": "$HOME/.local/bin/niri-display-mode toggle",
        "on-click-right": "$HOME/.local/bin/niri-display-mode menu"
    },

    "custom/power": {
        "format": "<span size='x-large'>⏻</span>",
        "tooltip-format": "Power menu",
        "on-click": "sh $HOME/.config/waybar/powermenu.sh"
    }
}
