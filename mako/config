# mako — Wayland notification daemon. Nord theme.
# Reloads with `makoctl reload`. See mako(5) for all options.

font=Hack Nerd Font 11
width=360
height=120
margin=10
padding=12
border-size=2
border-radius=8
default-timeout=5000
max-visible=5
anchor=top-right
icons=1

# Nord palette
background-color=#2e3440
text-color=#eceff4
border-color=#88c0d0
progress-color=over #434c5e

[urgency=low]
border-color=#4c566a

[urgency=high]
border-color=#bf616a
default-timeout=0
